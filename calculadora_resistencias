BANDAS = ["#7B3F00", "#111111", "#E02D2D", "#F2B600"]


def nivel(err: float):
    """(color, fondo, etiqueta) según la precisión alcanzada."""
    if err <= 1e-9:
        return "#0E9F6E", "#E7F7F0", "Valor exacto"
    if err <= 0.1:
        return "#0E9F6E", "#E7F7F0", "Excelente"
    if err <= 1.0:
        return "#2F6FED", "#EAF1FF", "Muy buena"
    if err <= 5.0:
        return "#D98A00", "#FFF4DD", "Aceptable"
    return "#D93636", "#FDECEC", "Baja precisión"


def kpi(titulo, valor, nota="", extra=""):
    return (f'<div class="kpi {extra}"><div class="k">{titulo}</div>'
            f'<div class="v">{valor}</div><div class="n">{nota}</div></div>')


def render_resultados(res):
    objetivo, serie, tol, top, total, n_vals = (
        res["objetivo"], res["serie"], res["tol"], res["top"], res["total"], res["n"])
    mejor = top[0]
    color, fondo, etiqueta = nivel(mejor["err"])
    cumple = mejor["err"] <= tol
    nombre, simbolica = TOPOLOGIAS[mejor["kind"]]
    _, con_valores = formula(mejor["kind"], mejor["vals"])

    c1, c2, c3 = st.columns(3)
    c1.markdown(kpi("Valor objetivo", fmt(objetivo), f"Serie {serie} · {n_vals} valores"),
                unsafe_allow_html=True)
    c2.markdown(kpi("Equivalente obtenido", fmt(mejor["eq"]), nombre), unsafe_allow_html=True)
    estado = f"Dentro de la tolerancia de ±{tol:g} %" if cumple else f"Fuera de la tolerancia de ±{tol:g} %"
    c3.markdown(
        f'<div class="kpi err" style="--c:{color};--bg:{fondo}"><div class="k">Error porcentual</div>'
        f'<div class="v">{mejor["err"]:.4f} %</div><div class="n">{etiqueta} · {estado}</div></div>',
        unsafe_allow_html=True)

    st.markdown(
        f'<div class="best" style="--c:{color}"><div class="txt">'
        f'<div class="t">Mejor combinación: {nombre.lower()}</div>'
        f'<div class="f">Fórmula: <b>{simbolica}</b></div>'
        f'<div class="f">{con_valores} = <b>{fmt(mejor["eq"])}</b></div>'
        f'<div class="n" style="color:#4A5873;margin-top:.5rem;font-size:.88rem">'
        f'Se evaluaron {total:,} combinaciones.</div></div>'
        f'<div class="sch">{esquema(mejor["kind"], mejor["vals"], 110)}</div></div>'.replace(",", "."),
        unsafe_allow_html=True)

    st.markdown('<div class="sec">Top 10 de arreglos con menor error</div>', unsafe_allow_html=True)
    for i, r in enumerate(top, 1):
        col, _, lab = nivel(r["err"])
        nom, sim = TOPOLOGIAS[r["kind"]]
        _, txt = formula(r["kind"], r["vals"])
        cant = "1 resistencia" if r["n"] == 1 else f"{r['n']} resistencias"
        st.markdown(
            f'<div class="row" style="--c:{col}"><div class="rk">{i}</div>'
            f'<div class="info"><div class="fx">{sim}</div>'
            f'<div class="fv">{txt} = <b>{fmt(r["eq"])}</b></div>'
            f'<div class="meta">{nom}, {cant}</div></div>'
            f'<div class="sch">{esquema(r["kind"], r["vals"], 64)}</div>'
            f'<div class="er"><span class="badge">{r["err"]:.4f} %</span>'
            f'<span class="lab">{lab}</span></div></div>',
            unsafe_allow_html=True)

    st.markdown(
        '<div class="nota">Colores del error: verde ≤ 0,1 % · azul ≤ 1 % · ámbar ≤ 5 % · rojo > 5 %. '
        'El símbolo ∥ indica conexión en paralelo y + conexión en serie.</div>',
        unsafe_allow_html=True)


# ─────────────────────────────────────────────────────────────
# 5. APLICACIÓN
# ─────────────────────────────────────────────────────────────
def main():
    st.set_page_config(page_title="Resistencias equivalentes", page_icon="Ω", layout="wide")
    st.markdown(CSS, unsafe_allow_html=True)

    bandas = "".join(f'<div class="band" style="background:{c}"></div>' for c in BANDAS)
    st.markdown(
        f'<div class="resistor"><div class="wire"></div><div class="body">{bandas}</div>'
        f'<div class="wire"></div></div>'
        '<h1 class="titulo">Resistencias equivalentes</h1>'
        '<p class="sub">Indica el valor que necesitas y la tolerancia disponible. '
        'Probamos todas las combinaciones de hasta 3 resistencias comerciales, '
        'en serie, en paralelo y mixtas, y te mostramos las que más se acercan.</p>',
        unsafe_allow_html=True)

    col_in, col_out = st.columns([1, 2.3], gap="large")

    with col_in:
        with st.container(border=True):
            st.markdown("### Datos del diseño")
            valor = st.number_input("Resistencia objetivo", min_value=0.0, value=1234.0,
                                    step=1.0, format="%g")
            unidad = st.radio("Unidad", list(UNIDADES), horizontal=True)
            tol_label = st.radio("Tolerancia requerida", list(TOLERANCIAS),
                                 help="1 % usa la serie E24 (24 valores por década). "
                                      "10 % usa la serie E12 (12 valores por década).")
            calcular = st.button("Calcular combinación óptima", type="primary")

    objetivo = valor * UNIDADES[unidad]
    serie, tol = TOLERANCIAS[tol_label]

    if calcular:
        if objetivo <= 0:
            st.session_state.pop("res", None)
            with col_out:
                st.error("Ingresa un valor mayor que 0 Ω para poder calcular.")
        else:
            with st.spinner("Evaluando combinaciones…"):
                top, total, n_vals = buscar_mejores(objetivo, serie)
            st.session_state["res"] = dict(objetivo=objetivo, serie=serie, tol=tol,
                                           top=top, total=total, n=n_vals)

    with col_out:
        res = st.session_state.get("res")
        if res:
            if not (0.1 <= res["objetivo"] <= 3e6):
                st.info("El valor está fuera del rango de 0,1 Ω a 1 MΩ de la serie; "
                        "la precisión será limitada.")
            render_resultados(res)
        else:
            st.markdown(
                '<div class="panel"><h3>Aún no hay resultados</h3>'
                '<p style="color:#4A5873;margin:.3rem 0 0 0">Completa los datos de la izquierda '
                'y pulsa «Calcular combinación óptima».</p></div>',
                unsafe_allow_html=True)


if __name__ == "__main__":
    main()
