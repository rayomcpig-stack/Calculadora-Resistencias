"""
Calculadora de resistencias equivalentes (series E12 / E24)
-----------------------------------------------------------
Encuentra la mejor combinación de 1, 2 o 3 resistencias comerciales
(serie, paralelo y mixtas) para aproximar un valor objetivo.

Ejecutar:  streamlit run app.py"""

import numpy as np
import streamlit as st

# ─────────────────────────────────────────────────────────────
# 1. DATOS: series comerciales y utilidades de formato
# ─────────────────────────────────────────────────────────────
E12 = [1.0, 1.2, 1.5, 1.8, 2.2, 2.7, 3.3, 3.9, 4.7, 5.6, 6.8, 8.2]
E24 = [1.0, 1.1, 1.2, 1.3, 1.5, 1.6, 1.8, 2.0, 2.2, 2.4, 2.7, 3.0,
       3.3, 3.6, 3.9, 4.3, 4.7, 5.1, 5.6, 6.2, 6.8, 7.5, 8.2, 9.1]
SERIES = {"E12": E12, "E24": E24}

TOLERANCIAS = {
    "1 %  ·  serie E24": ("E24", 1.0),
    "10 %  ·  serie E12": ("E12", 10.0),
}
UNIDADES = {"Ω": 1.0, "kΩ": 1e3, "MΩ": 1e6}

TOPOLOGIAS = {
    "single": ("Resistencia única", "R1"),
    "s2": ("Serie de 2", "R1 + R2"),
    "p2": ("Paralelo de 2", "R1 ∥ R2"),
    "s3": ("Serie de 3", "R1 + R2 + R3"),
    "p3": ("Paralelo de 3", "R1 ∥ R2 ∥ R3"),
    "m1": ("Mixto: paralelo en serie", "(R1 ∥ R2) + R3"),
    "m2": ("Mixto: serie en paralelo", "(R1 + R2) ∥ R3"),
}
ORDEN_TOPO = {k: i for i, k in enumerate(TOPOLOGIAS)}


def build_values(serie: str) -> np.ndarray:
    """Valores comerciales de 0.1 Ω a 1 MΩ para la serie indicada."""
    vals = {round(b * 10.0 ** e, 6) for e in range(-1, 6) for b in SERIES[serie]}
    vals.add(1_000_000.0)
    return np.array(sorted(vals))


def fmt(v: float) -> str:
    if v >= 1e6:
        return f"{v / 1e6:.4g} MΩ"
    if v >= 1e3:
        return f"{v / 1e3:.4g} kΩ"
    return f"{v:.4g} Ω"


def short(v: float) -> str:
    if v >= 1e6:
        return f"{v / 1e6:.3g}M"
    if v >= 1e3:
        return f"{v / 1e3:.3g}k"
    return f"{v:.3g}"


# ─────────────────────────────────────────────────────────────
# 2. ALGORITMO: búsqueda exhaustiva vectorizada con NumPy
# ─────────────────────────────────────────────────────────────
def _top(err: np.ndarray, k: int) -> np.ndarray:
    if err.size <= k:
        return np.arange(err.size)
    return np.argpartition(err, k - 1)[:k]


@st.cache_data(show_spinner=False)
def buscar_mejores(objetivo: float, serie: str, top_n: int = 10):
    v = build_values(serie)
    n = len(v)
    K = top_n * 3  # candidatos por topología (margen para desempates)
    cand = []

    def error(eq):
        return np.abs(eq - objetivo) / objetivo * 100.0

    def agregar(kind, eq, valores):
        err = error(eq)
        for i in _top(err, K):
            vals = tuple(float(x[i]) for x in valores)
            cand.append({"kind": kind, "vals": vals,
                         "eq": float(eq[i]), "err": float(err[i]),
                         "n": len(vals)})

    # 1 resistencia
    agregar("single", v, [v])

    # 2 resistencias (a ≤ b: las combinaciones son simétricas)
    ia, ib = np.triu_indices(n)
    a, b = v[ia], v[ib]
    agregar("s2", a + b, [a, b])
    agregar("p2", a * b / (a + b), [a, b])

    # 3 resistencias: serie pura y paralelo puro (a ≤ b ≤ c)
    A, B, C = [], [], []
    for i in range(n):
        sub = v[i:]
        jj, kk = np.triu_indices(len(sub))
        A.append(np.full(jj.size, v[i]))
        B.append(sub[jj])
        C.append(sub[kk])
    A, B, C = np.concatenate(A), np.concatenate(B), np.concatenate(C)
    agregar("s3", A + B + C, [A, B, C])
    agregar("p3", 1.0 / (1.0 / A + 1.0 / B + 1.0 / C), [A, B, C])
    n_triples = A.size

    # Mixtos: (R1 ∥ R2) + R3  y  (R1 + R2) ∥ R3  → R3 recorre toda la lista
    par = a * b / (a + b)
    ser = a + b
    for kind, base, eq in (
        ("m1", par, par[:, None] + v[None, :]),
        ("m2", ser, ser[:, None] * v[None, :] / (ser[:, None] + v[None, :])),
    ):
        err = error(eq).ravel()
        for idx in _top(err, K):
            p, c = divmod(int(idx), n)
            vals = (float(a[p]), float(b[p]), float(v[c]))
            cand.append({"kind": kind, "vals": vals,
                         "eq": float(eq[p, c]), "err": float(err[idx]),
                         "n": 3})

    total = n + 2 * a.size + 2 * n_triples + 2 * a.size * n

    # Orden: menor error → menos componentes → orden de topología
    cand.sort(key=lambda r: (round(r["err"], 9), r["n"], ORDEN_TOPO[r["kind"]]))
    vistos, final = set(), []
    for r in cand:
        clave = (r["kind"], r["vals"])
        if clave in vistos:
            continue
        vistos.add(clave)
        final.append(r)
        if len(final) == top_n:
            break
    return final, total, n


def arbol(kind: str, vals: tuple):
    """Representa el circuito como árbol para dibujarlo."""
    R = [("R", x) for x in vals]
    if kind == "single":
        return R[0]
    if kind in ("s2", "s3"):
        return ("S", R)
    if kind in ("p2", "p3"):
        return ("P", R)
    if kind == "m1":
        return ("S", [("P", R[:2]), R[2]])
    return ("P", [("S", R[:2]), R[2]])


def formula(kind: str, vals: tuple):
    """Devuelve (fórmula simbólica, fórmula con valores)."""
    sym = TOPOLOGIAS[kind][1]
    txt = sym
    for i, x in enumerate(vals, 1):
        txt = txt.replace(f"R{i}", fmt(x))
    return sym, txt


# ─────────────────────────────────────────────────────────────
# 3. DIBUJO: esquema SVG del circuito
# ─────────────────────────────────────────────────────────────
INK = "#14213D"


def _wire(x1, y1, x2, y2):
    return (f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2}" '
            f'stroke="{INK}" stroke-width="2" stroke-linecap="round"/>')


def _render(node):
    """Devuelve (svg, ancho, alto, y_de_conexión)."""
    t = node[0]
    if t == "R":
        svg = (_wire(0, 18, 18, 18) + _wire(74, 18, 92, 18)
               + f'<rect x="18" y="6" width="56" height="24" rx="4" fill="#EAF0F8" '
                 f'stroke="{INK}" stroke-width="2"/>'
               + f'<text x="46" y="22" text-anchor="middle" font-size="11" '
                 f'font-weight="600" fill="{INK}" '
                 f'font-family="Manrope, Arial, sans-serif">{short(node[1])}</text>')
        return svg, 92, 36, 18

    partes = [_render(c) for c in node[1]]
    if t == "S":
        arriba = max(p[3] for p in partes)
        abajo = max(p[2] - p[3] for p in partes)
        x, out = 0, []
        for svg, w, h, cy in partes:
            out.append(f'<g transform="translate({x},{arriba - cy})">{svg}</g>')
            x += w
        return "".join(out), x, arriba + abajo, arriba

    # Paralelo
    pad, gap = 16, 10
    maxw = max(p[1] for p in partes)
    W = maxw + 2 * pad
    y, out, cys = 0, [], []
    for svg, w, h, cy in partes:
        out.append(f'<g transform="translate({pad},{y})">{svg}</g>')
        ay = y + cy
        cys.append(ay)
        if w < maxw:
            out.append(_wire(pad + w, ay, pad + maxw, ay))
        out.append(f'<circle cx="{pad}" cy="{ay}" r="2.5" fill="{INK}"/>')
        out.append(f'<circle cx="{pad + maxw}" cy="{ay}" r="2.5" fill="{INK}"/>')
        y += h + gap
    H = y - gap
    mid = (cys[0] + cys[-1]) / 2
    out += [_wire(pad, cys[0], pad, cys[-1]),
            _wire(pad + maxw, cys[0], pad + maxw, cys[-1]),
            _wire(0, mid, pad, mid), _wire(pad + maxw, mid, W, mid)]
    return "".join(out), W, H, mid


def esquema(kind: str, vals: tuple, alto_px: int = 90) -> str:
    svg, w, h, cy = _render(arbol(kind, vals))
    ancho = w + 24
    alto = h + 20
    return (f'<svg viewBox="0 0 {ancho} {alto}" xmlns="http://www.w3.org/2000/svg" '
            f'style="height:{alto_px}px;width:auto;max-width:100%">'
            f'<g transform="translate(12,10)">{svg}</g>'
            f'<circle cx="12" cy="{cy + 10}" r="4" fill="#fff" stroke="{INK}" stroke-width="2"/>'
            f'<circle cx="{w + 12}" cy="{cy + 10}" r="4" fill="#fff" stroke="{INK}" stroke-width="2"/>'
            f'</svg>')


